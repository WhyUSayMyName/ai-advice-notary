# Скопируйте в .env и заполните. .env в .gitignore и не должен попадать в git.
# Этот файл нужен ТОЛЬКО для hardhat: компиляции, тестов и деплоя контракта.
# Приложению нужен свой blockchain_notary/.env — там другие значения.

# ── Локальная разработка ──────────────────────────────────────────────
# Узел: npx hardhat node
RPC_URL=http://127.0.0.1:8545

# Заполняется автоматически скриптом деплоя, руками менять не нужно
NOTARY_ADDRESS=

# ── Деплой в тестнет ──────────────────────────────────────────────────
# HTTPS-эндпоинт Sepolia: Alchemy, Infura или свой узел.
SEPOLIA_RPC_URL=

# Приватный ключ аккаунта, который РАЗВЕРНЁТ контракт. Лежит здесь
# открытым текстом, поэтому годится только одноразовый тестовый аккаунт
# без реальных средств. Это не тот ключ, которым приложение якорит
# документы: тот хранится зашифрованным средствами ОС и задаётся
# в интерфейсе, а не здесь.
DEPLOYER_PK=

# Ключ Etherscan для верификации исходников контракта. Не секрет в смысле
# денег, но и не для публикации. Без него деплой пройдёт, а `npm run
# verify:sepolia` — нет.
ETHERSCAN_API_KEY=
